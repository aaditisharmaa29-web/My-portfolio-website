---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="desk-window" data-visible="false" id="desk-window">
  <h1 class="desk-window__title">{title}</h1>
  <div class="desk-window__body">
    <slot />
  </div>
</div>

<script>
  function reveal() {
    const win = document.getElementById('desk-window');
    if (!win) return;
    // small delay so it appears right as the lock screen fades
    setTimeout(() => win.setAttribute('data-visible', 'true'), 150);
  }
  reveal();
  document.addEventListener('astro:page-load', reveal);
</script>