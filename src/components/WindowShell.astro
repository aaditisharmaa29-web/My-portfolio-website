---
const { app, title } = Astro.props;
---

<div class="window" data-app={app}>
  <div class="window-header">
    <div class="traffic-lights">
      <button class="window-close" type="button" aria-label="Close"></button>
      <button class="window-minimise" type="button" aria-label="Minimise">–</button>
      <button class="window-maximise" type="button" aria-label="Maximise">□</button>
    </div>
    <h3 class="window-title">{title}</h3>
  </div>

  <div class="window-content">
    <slot />
  </div>

  <div class="resize-handle"></div>
</div>
