---
import Resume from "../windows/Resume.astro";
import Projects from "../windows/Projects.astro";
import Fun from "../windows/Fun.astro";
import Contact from "../windows/Contact.astro";
---

<div id="desktop" class="desktop">

    <!-- Hidden App Templates -->

    <div id="app-templates" style="display:none;">

        <div id="resume-template">

            <Resume />

        </div>

        <div id="projects-template">

            <Projects />

        </div>

        <div id="fun-template">

            <Fun />

        </div>

        <div id="contact-template">

            <Contact />

        </div>

    </div>

    <!-- Active Windows -->

    <div
        id="window-layer"
        class="window-layer"
    ></div>

    <!-- Window Template -->

    <template id="window-template">

        <div class="window">

            <div class="window-header">

                <div class="traffic-lights">

                    <button class="window-close"></button>

                    <button class="window-minimise"></button>

                    <button class="window-maximise"></button>

                </div>

                <h3 class="window-title">

                    Window

                </h3>

            </div>

            <div class="window-content"></div>

            <div class="resize-handle"></div>

        </div>

    </template>

</div>