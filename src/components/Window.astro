---
const { id = "", title = "Window", variant = "" } = Astro.props;

const windowClass = variant === "static" ? "window window--static" : "window";
---

<div id={id} class={windowClass}>
  <!-- Title Bar -->

  <div class="window-header">
    <div class="traffic-lights">
      {
        variant === "static" ? (
          <a href="/" class="window-close" aria-label="Back to desktop" />
        ) : (
          <button class="window-close" aria-label="Close" />
        )
      }

      <button class="window-minimise" aria-label="Minimise"></button>

      <button class="window-maximise" aria-label="Maximise"></button>
    </div>

    <h3 class="window-title">
      {title}
    </h3>
  </div>

  <!-- Content -->

  <div class="window-content">
    <slot />
  </div>

  <!-- Resize Handle -->

  <div class="resize-handle"></div>
</div>
