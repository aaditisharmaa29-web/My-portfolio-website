---
import { getCollection, render, type CollectionEntry } from "astro:content";

interface Props {
  activeProjectId?: string;
}

const { activeProjectId } = Astro.props;

const projects = (await getCollection("projects")).sort(
  (a: { data: { order?: number } }, b: { data: { order?: number } }) =>
    (a.data.order ?? 0) - (b.data.order ?? 0),
);

const projectEntries = await Promise.all(
  projects.map(async (project: CollectionEntry<"projects">) => {
    const { Content } = await render(project);
    return {
      ...project,
      id: project.id.replace(/\.md$/, ""),
      Content,
    };
  }),
);

const isProjectOpen = Boolean(activeProjectId);
---

<div class="projects-container">
  <div class="projects-toolbar">
    <a
      class="retro-back-btn projects-back-btn"
      href="/projects"
      data-back-url="/projects"
      style={isProjectOpen ? "display:inline-flex" : "display:none;"}
    >
      <span>◄</span> Back
    </a>
  </div>

  <div class="projects-grid" style={isProjectOpen ? "display:none;" : undefined}>
    {
      projectEntries.map((project) => (
        <a class="project-folder-item" href={`/projects/${project.id}`} data-project={project.id}>
          <span class="folder-icon folder-darkblue" aria-hidden="true" />
          <span class="icon-label">{project.data.title}</span>
        </a>
      ))
    }
  </div>

  <div class="project-views">
    {
      projectEntries.map((project) => (
        <div
          class={
            activeProjectId === project.id ? "project-detail-view active" : "project-detail-view"
          }
          data-view={project.id}
        >
          <h3>{project.data.title}</h3>
          <project.Content />
        </div>
      ))
    }
  </div>
</div>

