---
const currentPath = Astro.url.pathname;

const links = [
    { href: "/projects", label: "PROJECTS" },
    { href: "/resume", label: "RESUME" },
    { href: "/fun", label: "FUN" },
    { href: "/contact", label: "CONTACT" },
];
---

<nav class="desktop-nav">

    {links.map((link) => (
        <a
            href={link.href}
            aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
        >
            {link.label}
        </a>
    ))}

</nav>