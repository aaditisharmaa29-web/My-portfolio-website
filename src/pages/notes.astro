---
import Layout from '../layouts/Layout.astro';
import Mac from '../components/Mac.astro';
import DeskWindow from '../components/DeskWindow.astro';
---

<Layout title="Notes — Lily" active="notes">
  <Mac showSticky={false}>
    <DeskWindow title="Notes">
      <p>Want to get in touch? Leave a note.</p>

      <form class="contact-form">
        <label>
          Name
          <input type="text" name="name" placeholder="Your name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" placeholder="you@email.com" required />
        </label>
        <label>
          Message
          <textarea name="message" rows="4" placeholder="Say hi..." required></textarea>
        </label>
        <button type="submit">Send note →</button>
      </form>
    </DeskWindow>
  </Mac>
</Layout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 380px;
    margin-top: 0.75rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    border: 1px solid rgba(35, 33, 48, 0.2);
    background: #fff;
    resize: vertical;
  }

  .contact-form button {
    align-self: flex-start;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    cursor: pointer;
    margin-top: 0.25rem;
  }
</style>