---
import Layout from '../layouts/Layout.astro';
import Mac from '../components/Mac.astro';
import DeskWindow from '../components/DeskWindow.astro';
---

<Layout title="Fun — Lily" active="fun">
  <Mac showSticky={false}>
    <DeskWindow title="Fun stuff">
      <p>
        This is the place for whatever doesn't fit anywhere else —
        side projects, hobbies, playlists, a photo dump, anything you
        want. Swap this copy out for whatever you like.
      </p>
    </DeskWindow>
  </Mac>
</Layout>