---
import Layout from '../layouts/Layout.astro';
import Mac from '../components/Mac.astro';
import DeskWindow from '../components/DeskWindow.astro';

const projects = [
  {
    name: 'Project One',
    blurb: 'A short description of this project goes here — what it is and what you built.',
    tags: ['React', 'Node'],
  },
  {
    name: 'Project Two',
    blurb: 'Swap this out with real project write-ups whenever you\u2019re ready.',
    tags: ['Astro', 'CSS'],
  },
  {
    name: 'Project Three',
    blurb: 'Each card can link out to a case study or a live demo.',
    tags: ['Design'],
  },
];
---

<Layout title="Projects — Lily" active="projects">
  <Mac showSticky={false}>
    <DeskWindow title="Projects">
      <div class="project-grid">
        {
          projects.map((p) => (
            <div class="project-card">
              <h2>{p.name}</h2>
              <p>{p.blurb}</p>
              <div class="project-card__tags">
                {p.tags.map((t) => <span>{t}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </DeskWindow>
  </Mac>
</Layout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .project-card {
    background: #fff;
    border: 1px solid rgba(35, 33, 48, 0.12);
    border-radius: 10px;
    padding: clamp(0.9rem, 2vw, 1.2rem);
  }

  .project-card h2 {
    font-family: var(--font-hand);
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    margin: 0 0 0.35rem;
  }

  .project-card p {
    font-size: clamp(0.7rem, 1.3vw, 0.82rem);
    line-height: 1.5;
    margin: 0 0 0.6rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .project-card__tags span {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--sticky-blue);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
</style>