---
import Layout from '../layouts/Layout.astro';
import Mac from '../components/Mac.astro';
import DeskWindow from '../components/DeskWindow.astro';
---

<Layout title="Resume — Lily" active="resume">
  <Mac showSticky={false}>
    <DeskWindow title="Resume">
      <p>
        A quick summary of your experience goes here. Keep it to two or
        three lines that give a sense of what you do and what you're
        looking for.
      </p>

      <a class="resume__download" href="/resume.pdf" download>
        Download PDF ↓
      </a>

      <div class="resume__section">
        <h3>Experience</h3>
        <div class="resume__entry">
          <div class="resume__entry-head">
            <strong>Role, Company</strong>
            <span>2024 — Present</span>
          </div>
          <p>What you did, in a sentence or two.</p>
        </div>
        <div class="resume__entry">
          <div class="resume__entry-head">
            <strong>Role, Company</strong>
            <span>2022 — 2024</span>
          </div>
          <p>What you did, in a sentence or two.</p>
        </div>
      </div>

      <div class="resume__section">
        <h3>Skills</h3>
        <p>List the tools, languages, and skills you want to highlight.</p>
      </div>
    </DeskWindow>
  </Mac>
</Layout>

<style>
  .resume__download {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    margin: 0.75rem 0 1.5rem;
  }

  .resume__section h3 {
    font-family: var(--font-hand);
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    margin: 1.25rem 0 0.5rem;
  }

  .resume__entry {
    margin-bottom: 0.9rem;
  }

  .resume__entry-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
    margin-bottom: 0.15rem;
  }

  .resume__entry-head span {
    opacity: 0.6;
    white-space: nowrap;
  }
</style>