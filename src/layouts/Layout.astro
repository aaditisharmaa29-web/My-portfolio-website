---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const { title = "Aditi's Portfolio" } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
</head>
<body>
    <main class="homepage">

     <Navbar />

        <button id="back-button" class="back-button" aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
        </button>

        <div class="mac-frame">
            <div class="mac-bezel">
                <slot />
            </div>


            <div class="mac-chin">
                <div class="mac-camera"></div>
            </div>
            <div class="mac-stand-neck"></div>
            <div class="mac-stand-base"></div>
        </div>
    </main>

    <script type="module" src="/src/scripts/desktop.js"></script>
</body>
</html>