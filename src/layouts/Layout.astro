---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const { title = "Aditi's Portfolio" } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
</head>
<body>
    <main class="homepage">

        <Navbar />

        <button id="back-button" class="back-button" aria-label="Back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
        </button>

        <div class="mac-frame">
            <div class="mac-bezel">
                <div class="mac-screen-ring">
                    <slot />
                </div>
            </div>
            <div class="mac-chin">
                <div class="mac-logo" aria-hidden="true"></div>
                <div class="mac-disk-slot" aria-hidden="true"></div>
            </div>
            <div class="mac-stand-neck"></div>
            <div class="mac-stand-base"></div>
        </div>
    </main>

    <!-- WINDOW TEMPLATE (Cloned by desktop.js when buttons are clicked) -->
    <template id="window-template">
        <div class="window">
            <div class="window-header">
                <div class="traffic-lights">
                    <button class="window-close" title="Close">×</button>
                    <button class="window-minimise" title="Minimize">–</button>
                    <button class="window-maximise" title="Full Screen">□</button>
                </div>
                <span class="window-title">Window</span>
            </div>
            <div class="window-content"></div>
            <div class="resize-handle"></div>
        </div>
    </template>

    <script src="../scripts/desktop.js"></script>
</body>
</html>