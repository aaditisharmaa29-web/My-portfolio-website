---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { appByUrl } from "../data/apps";
import Navbar from "../components/content/Navbar.astro";
import Desktop from "../components/Desktop.astro";
import WindowShell from "../components/WindowShell.astro";
import ResumeContent from "../components/content/ResumeContent.astro";
import FunContent from "../components/content/FunContent.astro";
import ContactContent from "../components/content/ContactContent.astro";
import ProjectsWindow from "../components/ProjectsWindow.astro";

const { title = "Aditi's Portfolio", activeProjectId } = Astro.props;

const currentApp = appByUrl(Astro.url.pathname);
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-current-app={currentApp}>
    <main class="homepage">
      <Navbar currentApp={currentApp} />

      <div class="scene">
        <div class="mac-container">
          <div class="mac-frame" transition:persist="desktop">
            <div class="mac-case">
              <div class="mac-bezel">
                <div class="mac-bezel-top" aria-hidden="true"></div>
                <div class="mac-bezel-side" aria-hidden="true"></div>

                <!-- screen ring lives INSIDE the bezel so the plastic wraps around it -->
                <div class="mac-screen-ring">
                  <Desktop />
                  <div id="dock" class="dock"></div>
                </div>
              </div>

              <!-- chin sits below the bezel, still part of the rigid mac-case group -->
              <div class="mac-chin">
                <div class="mac-logo" aria-hidden="true"></div>
                <div class="mac-disk-slot" aria-hidden="true"></div>
              </div>
            </div>

            <div class="mac-stand-neck"></div>
            <div class="mac-stand-base"></div>
          </div>
        </div>
      </div>
    </main>

    <!-- One hidden window per app. windows.js copies these onto the desktop. -->
    <template data-app="resume">
      <WindowShell app="resume" title="Resume">
        <ResumeContent />
      </WindowShell>
    </template>

    <template data-app="projects">
      <WindowShell app="projects" title="Projects">
        <ProjectsWindow activeProjectId={activeProjectId} />
      </WindowShell>
    </template>

    <template data-app="fun">
      <WindowShell app="fun" title="Fun">
        <FunContent />
      </WindowShell>
    </template>

    <template data-app="contact">
      <WindowShell app="contact" title="Contact">
        <ContactContent />
      </WindowShell>
    </template>

    <script src="../scripts/windows.js"></script>
  </body>
</html>